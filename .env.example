# Public website settings only. Never add Supabase keys or Apple credentials.
# These are evaluated at build time. Rebuild after changing them.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_OPERATOR_NAME=

# Leave empty until the app is publicly available.
# The app's existing Apple ID is 6820780610.
NEXT_PUBLIC_APP_STORE_URL=

# Set true only after the policy and launch details have been reviewed.
NEXT_PUBLIC_PRIVACY_APPROVED=false
