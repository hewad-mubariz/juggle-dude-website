# Public website settings only. Never add Supabase keys or Apple credentials.
# These values are included in the public static export. Rebuild after changes.
NEXT_PUBLIC_SITE_URL=https://juggledude.com
NEXT_PUBLIC_OPERATOR_NAME=Hewad Mubariz
NEXT_PUBLIC_SUPPORT_EMAIL=hello@juggledude.com
# Set true only after testing incoming email and monitoring this mailbox.
NEXT_PUBLIC_SUPPORT_EMAIL_CONFIRMED=false
# A lawful public business/service address. No address is inferred or published by default.
NEXT_PUBLIC_CONTACT_ADDRESS=

# Complete, user-facing statements verified against production operations.
# Use quoted values for spaces. For multiple paragraphs, edit the policy source instead.
# Providers (Supabase, web host, email), locations, transfer safeguards/contact route.
NEXT_PUBLIC_PROCESSING_DETAILS=
# Specific periods/criteria for logs, support, backups, deletion and legal exceptions.
NEXT_PUBLIC_RETENTION_DETAILS=
# Real, tested in-app deletion steps, what is erased, timing and confirmation.
NEXT_PUBLIC_DELETION_INSTRUCTIONS=

# Leave empty until the app is publicly available. Apple ID: 6820780610.
NEXT_PUBLIC_APP_STORE_URL=

# Review flag, not a legal or Apple approval guarantee. Requires the details above.
NEXT_PUBLIC_PRIVACY_APPROVED=false
